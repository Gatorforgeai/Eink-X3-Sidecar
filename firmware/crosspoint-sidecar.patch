+        switch (state_) {
+            case State::Idle:
+                if (sink_->hasPendingBundle() && (byte == kOpBegin || byte == kOpBeginPage ||
+                    byte == kOpBeginGroupPage || byte == kOpClear)) {
+                    LOG_ERR("FRAME", "%s", "legacy operation rejected while deferred catalog is pending");
+                    abortTransfer();  // The sink preserves its fully verified pending catalog.
+                    i = len;
+                    break;
+                }
+                if (bundleTransactionActive_) {
+                    const bool matchingContinuation =
+                        (groupMode_ && byte == kOpBeginGroupPage) ||
+                        (!groupMode_ && byte == kOpBeginPage);
+                    if (!matchingContinuation) {
+                        LOG_ERR("FRAME", "%s", "operation rejected while bundle is staging");
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                }
+                if (byte == kOpBegin || byte == kOpBeginPage || byte == kOpBeginGroupPage) {
+                    const bool pageMode = byte == kOpBeginPage || byte == kOpBeginGroupPage;
+                    const bool groupMode = byte == kOpBeginGroupPage;
+                    // Only a non-zero page/offset can continue staging. Any new transaction
+                    // abandons the previous staging state before its header is parsed.
+                    // Wire byte 0 is the opcode. Group offset is hdrBuf_[18], therefore data[19]:
+                    // op, x2, y2, w2, h2, format, length4, page, count, active, start, groupCount, offset.
+                    const bool transactionStart = groupMode
+                        ? (len >= 20 && data[19] == 0)
+                        : (pageMode && len >= 15 && data[14] == 0);
+                    if (bundleTransactionActive_ && (!pageMode || transactionStart)) {
+                        LOG_ERR("FRAME", "%s", "new transaction rejected while bundle is staging");
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    const uint16_t expectedPacketLength = groupMode ? 24 : (pageMode ? 21 : 14);
+                    if (len != expectedPacketLength) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: wrong length");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    state_ = State::Begin;
+                    pageMode_ = pageMode;
+                    groupMode_ = groupMode;
+                    beginHeaderLength_ = groupMode ? 23 : (pageMode ? 20 : 13);
+                    hdrIdx_ = 0;
+                    bufIdx_ = 0;
+                } else if (byte == kOpClear) {
+                    if (len != 2) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame clear: wrong length");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    state_ = State::Clear;
+                    hdrIdx_ = 0;
+                } else {
+                    static bool logged = false;
+                    if (!logged) {
+                        snprintf(logBuf, sizeof(logBuf), "unknown opcode 0x%02X in Idle", byte);
+                        LOG_ERR("FRAME", "%s", logBuf);
+                        logged = true;
+                    }
+                    abortTransfer();
+                    i = len;  // Reject the entire malformed ATT write, including trailing bytes.
+                }
+                ++i;
+                break;
+
+            case State::Begin:
+                if (hdrIdx_ >= kMaxHdrBytes) {
+                    LOG_ERR("FRAME", "%s", "frame abort: header overrun");
+                    abortTransfer();
+                    i = len;
+                    break;
+                }
+                hdrBuf_[hdrIdx_++] = byte;
+                if (hdrIdx_ == beginHeaderLength_) {
+                    x_ = static_cast<uint16_t>(hdrBuf_[0]) | (static_cast<uint16_t>(hdrBuf_[1]) << 8);
+                    y_ = static_cast<uint16_t>(hdrBuf_[2]) | (static_cast<uint16_t>(hdrBuf_[3]) << 8);
+                    w_ = static_cast<uint16_t>(hdrBuf_[4]) | (static_cast<uint16_t>(hdrBuf_[5]) << 8);
+                    h_ = static_cast<uint16_t>(hdrBuf_[6]) | (static_cast<uint16_t>(hdrBuf_[7]) << 8);
+                    format_ = hdrBuf_[8];
+                    dataLength_ = static_cast<uint32_t>(hdrBuf_[9]) |
+                                  (static_cast<uint32_t>(hdrBuf_[10]) << 8) |
+                                  (static_cast<uint32_t>(hdrBuf_[11]) << 16) |
+                                  (static_cast<uint32_t>(hdrBuf_[12]) << 24);
+                    if (pageMode_) {
+                        pageIndex_ = hdrBuf_[13];
+                        pageCount_ = hdrBuf_[14];
+                        activePage_ = hdrBuf_[15];
+                        if (groupMode_) {
+                            groupStart_ = hdrBuf_[16]; groupCount_ = hdrBuf_[17]; groupOffset_ = hdrBuf_[18];
+                            expectedCrc_ = static_cast<uint32_t>(hdrBuf_[19]) |
+                                           (static_cast<uint32_t>(hdrBuf_[20]) << 8) |
+                                           (static_cast<uint32_t>(hdrBuf_[21]) << 16) |
+                                           (static_cast<uint32_t>(hdrBuf_[22]) << 24);
+                        } else {
+                            expectedCrc_ = static_cast<uint32_t>(hdrBuf_[16]) |
+                                           (static_cast<uint32_t>(hdrBuf_[17]) << 8) |
+                                           (static_cast<uint32_t>(hdrBuf_[18]) << 16) |
+                                           (static_cast<uint32_t>(hdrBuf_[19]) << 24);
+                        }
+                    }
+
+                    if (format_ != 0) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: unsupported format");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+
+                    if (w_ == 0 || h_ == 0) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: zero dimension");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+
+                    uint32_t xEnd = static_cast<uint32_t>(x_) + static_cast<uint32_t>(w_);
+                    uint32_t yEnd = static_cast<uint32_t>(y_) + static_cast<uint32_t>(h_);
+                    if (xEnd > static_cast<uint32_t>(sink_->width()) ||
+                        yEnd > static_cast<uint32_t>(sink_->height())) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: rect out of bounds");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+
+                    uint16_t rowBytes = (w_ + 7) / 8;
+                    if (rowBytes > kMaxRowBytes) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: row too wide");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+
+                    uint32_t expectedLength = static_cast<uint32_t>(rowBytes) * h_;
+                    if (dataLength_ != expectedLength) {
+                        static bool logged = false;
+                        if (!logged) {
+                            snprintf(logBuf, sizeof(logBuf),
+                                     "frame begin: length mismatch want=%lu got=%lu",
+                                     expectedLength, dataLength_);
+                            LOG_ERR("FRAME", "%s", logBuf);
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+
+                    bool wholePanel = (x_ == 0 && y_ == 0 &&
+                                       w_ == sink_->width() && h_ == sink_->height());
+                    if (pageMode_) {
+                        bool validBundle = wholePanel && pageCount_ > 0 && pageIndex_ < pageCount_ &&
+                                           activePage_ < pageCount_;
+                        if (groupMode_) {
+                            validBundle = validBundle && groupCount_ > 0 &&
+                                groupCount_ <= SidecarSink::kMaxGroupPages && groupStart_ < pageCount_ &&
+                                static_cast<uint16_t>(groupStart_) + groupCount_ <= pageCount_ &&
+                                groupOffset_ < groupCount_ && pageIndex_ == groupStart_ + groupOffset_;
+                            if (validBundle && groupOffset_ == 0) {
+                                validBundle = !bundleTransactionActive_ &&
+                                    sink_->beginPageGroup(pageCount_, activePage_, groupStart_, groupCount_);
+                                if (validBundle) {
+                                    bundleNextPage_ = groupStart_;
+                                    bundleActivePage_ = activePage_;
+                                    bundlePageCount_ = pageCount_;
+                                    bundleGroupStart_ = groupStart_;
+                                    bundleGroupCount_ = groupCount_;
+                                    bundleTransactionActive_ = true;
+                                }
+                            } else if (validBundle) {
+                                validBundle = bundleTransactionActive_ && pageIndex_ == bundleNextPage_ &&
+                                    activePage_ == bundleActivePage_ && pageCount_ == bundlePageCount_ &&
+                                    groupStart_ == bundleGroupStart_ && groupCount_ == bundleGroupCount_;
+                            }
+                        } else {
+                            validBundle = validBundle && pageCount_ <= SidecarSink::kMaxStoredPages;
+                            if (validBundle && pageIndex_ == 0) {
+                                validBundle = !bundleTransactionActive_ &&
+                                    sink_->beginPageBundle(pageCount_, activePage_);
+                                if (validBundle) {
+                                    bundleNextPage_ = 0;
+                                    bundleActivePage_ = activePage_;
+                                    bundlePageCount_ = pageCount_;
+                                    bundleTransactionActive_ = true;
+                                }
+                            } else if (validBundle) {
+                                validBundle = bundleTransactionActive_ && pageIndex_ == bundleNextPage_ &&
+                                    activePage_ == bundleActivePage_ && pageCount_ == bundlePageCount_;
+                            }
+                        }
+                        if (!validBundle) {
+                            LOG_ERR("FRAME", "%s", "page begin: invalid bundle metadata or storage unavailable");
+                            abortTransfer();
+                            i = len;
+                            break;
+                        }
+                    }
+                    if (wholePanel) {
+                        sink_->beginFrame();
+                    }
+
+                    dataReceived_ = 0;
+                    nextSeq_ = 0;
+                    rowY_ = 0;
+                    bufIdx_ = 0;
+                    runningCrc_ = 0xFFFFFFFFu;
+                    frameStartTime = millis();
+
+                    snprintf(logBuf, sizeof(logBuf),
+                             "frame begin x=%u y=%u w=%u h=%u len=%lu",
+                             x_, y_, w_, h_, dataLength_);
+                    LOG_INF("FRAME", "%s", logBuf);
+
+                    state_ = State::TransferWait;
+                }
+                ++i;
+                break;
+
+            case State::TransferWait:
+                if (byte == kOpData) {
+                    if (len - i < 3) {
+                        LOG_ERR("FRAME", "%s", "frame abort: short data header");
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    state_ = State::DataHdr;
+                    hdrIdx_ = 0;
+                } else if (byte == kOpEnd) {
+                    if (len - i != 2) {
+                        LOG_ERR("FRAME", "%s", "frame abort: malformed end packet");
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    state_ = State::End;
+                    hdrIdx_ = 0;
+                } else if (byte == kOpBegin || byte == kOpBeginPage || byte == kOpBeginGroupPage) {
+                    const bool pageMode = byte == kOpBeginPage || byte == kOpBeginGroupPage;
+                    const bool groupMode = byte == kOpBeginGroupPage;
+                    const uint16_t expectedPacketLength = groupMode ? 24 : (pageMode ? 21 : 14);
+                    if (len - i != expectedPacketLength) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame begin: wrong length");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    LOG_ERR("FRAME", "%s", "frame abort: new begin during transfer");
+                    abortTransfer();
+                    i = len;
+                    break;
+                } else if (byte == kOpClear) {
+                    if (len - i != 2) {
+                        static bool logged = false;
+                        if (!logged) {
+                            LOG_ERR("FRAME", "%s", "frame clear: wrong length");
+                            logged = true;
+                        }
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    LOG_ERR("FRAME", "%s", "frame abort: clear during transfer");
+                    abortTransfer();
+                    i = len;
+                    break;
+                } else {
+                    static bool logged = false;
+                    if (!logged) {
+                        snprintf(logBuf, sizeof(logBuf),
+                                 "unknown opcode 0x%02X in TransferWait", byte);
+                        LOG_ERR("FRAME", "%s", logBuf);
+                        logged = true;
+                    }
+                    abortTransfer();
+                    i = len;
+                    break;
+                }
+                ++i;
+                break;
+
+            case State::DataHdr:
+                if (hdrIdx_ >= kMaxHdrBytes) {
+                    LOG_ERR("FRAME", "%s", "frame abort: header overrun");
+                    abortTransfer();
+                    i = len;
+                    break;
+                }
+                hdrBuf_[hdrIdx_++] = byte;
+                if (hdrIdx_ == 2) {
+                    uint16_t seq = static_cast<uint16_t>(hdrBuf_[0]) |
+                                   (static_cast<uint16_t>(hdrBuf_[1]) << 8);
+                    if (seq != nextSeq_) {
+                        snprintf(logBuf, sizeof(logBuf),
+                                 "frame abort: seq gap want=%u got=%u", nextSeq_, seq);
+                        LOG_ERR("FRAME", "%s", logBuf);
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    ++nextSeq_;
+                    state_ = State::Data;
+                }
+                ++i;
+                break;
+
+            case State::Data: {
+                if (dataReceived_ >= dataLength_) {
+                    LOG_ERR("FRAME", "%s", "frame abort: payload overrun");
+                    abortTransfer();
+                    i = len;
+                    break;
+                }
+                uint16_t rowBytes = (w_ + 7) / 8;
+                rowBuf_[bufIdx_++] = byte;
+                runningCrc_ = crc32Byte(runningCrc_, byte);
+                ++dataReceived_;
+                if (bufIdx_ == rowBytes) {
+                    if (!sink_->blit1bpp(x_, y_ + rowY_, w_, 1, rowBuf_)) {
+                        snprintf(logBuf, sizeof(logBuf),
+                                 "frame abort: blit rejected row=%u", rowY_);
+                        LOG_ERR("FRAME", "%s", logBuf);
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    ++rowY_;
+                    bufIdx_ = 0;
+                }
+                ++i;
+                break;
+            }
+
+            case State::End: {
+                // refresh byte accepted and ignored in v1 - the sink owns the refresh mode
+                if (dataReceived_ != dataLength_) {
+                    snprintf(logBuf, sizeof(logBuf),
+                             "frame abort: short len want=%lu got=%lu",
+                             dataLength_, dataReceived_);
+                    LOG_ERR("FRAME", "%s", logBuf);
+                    abortTransfer();
+                    i = len;
+                    break;
+                }
+                if (pageMode_) {
+                    const uint32_t actualCrc = runningCrc_ ^ 0xFFFFFFFFu;
+                    if (actualCrc != expectedCrc_ || !sink_->storePage(pageIndex_, actualCrc)) {
+                        LOG_ERR("FRAME", "%s", "frame abort: page checksum or storage failure");
+                        abortTransfer();
+                        i = len;
+                        break;
+                    }
+                    bundleNextPage_ = static_cast<uint8_t>(pageIndex_ + 1);
+                    const bool transactionComplete = groupMode_
+                        ? (groupOffset_ + 1 == groupCount_)
+                        : (pageIndex_ + 1 == pageCount_);
+                    if (transactionComplete) {
+                        if (!sink_->commitPageBundle()) {
+                            LOG_ERR("FRAME", "%s", "frame abort: bundle commit failed");
+                            abortTransfer();
+                            i = len;
+                            break;
+                        }
+                        // A deferred sink has verified and staged the transaction but has not
+                        // published or presented it. Its owner reports completion after the later
+                        // cycle-boundary activation; the parser must not expose false success.
+                        frameComplete_ = !sink_->hasPendingBundle();
+                        pageMode_ = false;
+                        groupMode_ = false;
+                        bundleTransactionActive_ = false;
+                        bundleNextPage_ = 0;
+                        bundlePageCount_ = 0;
+                        bundleGroupStart_ = 0;
+                        bundleGroupCount_ = 0;
+                    }
+                } else {
+                    sink_->present();
+                    frameComplete_ = true;
+                    pageMode_ = false;
+                }
+                uint32_t elapsed = millis() - frameStartTime;
+                snprintf(logBuf, sizeof(logBuf),
+                         frameComplete_ ? "frame complete rows=%u bytes=%lu ms=%lu"
+                                        : "frame accepted rows=%u bytes=%lu ms=%lu",
+                         rowY_, dataReceived_, elapsed);
+                LOG_INF("FRAME", "%s", logBuf);
+                state_ = State::Idle;
+                hdrIdx_ = 0;
+                bufIdx_ = 0;
+                i = len;
+                break;
+            }
+
+            case State::Clear:
+                // colour byte accepted and ignored in v1 (sink clears white)
+                sink_->beginFrame();
+                sink_->present();
+                frameComplete_ = true;
+                state_ = State::Idle;
+                hdrIdx_ = 0;
+                bufIdx_ = 0;
+                i = len;
+                break;
+        }
+    }
+
+    if (state_ == State::Data) {
+        state_ = State::TransferWait;
+    }
+}
+
+bool SidecarFrameProtocol::inTransfer() const {
+    if (sink_ == nullptr) return false;
+    return state_ == State::TransferWait || state_ == State::DataHdr || state_ == State::Data;
+}
+
+bool SidecarFrameProtocol::consumeFrameComplete() {
+    const bool complete = frameComplete_;
+    frameComplete_ = false;
+    return complete;
+}
+
+void SidecarFrameProtocol::reset() {
+    abortTransfer();
+    frameComplete_ = false;
+}
+
+void SidecarFrameProtocol::abortTransfer() {
+    if (sink_ != nullptr) sink_->abandonPageBundle();
+    state_ = State::Idle;
+    hdrIdx_ = 0;
+    bufIdx_ = 0;
+    dataReceived_ = 0;
+    pageMode_ = false;
+    groupMode_ = false;
+    bundleNextPage_ = 0;
+    bundlePageCount_ = 0;
+    bundleGroupStart_ = 0;
+    bundleGroupCount_ = 0;
+    bundleTransactionActive_ = false;
+    frameComplete_ = false;
+}
+
+#else // !SIDECAR_LINK
+
+SidecarFrameProtocol::SidecarFrameProtocol(SidecarSink* /*sink*/)
+    : sink_(nullptr),
+      frameComplete_(false),
+      state_(State::Idle),
+      hdrIdx_(0),
+      x_(0), y_(0), w_(0), h_(0),
+      format_(0),
+      pageMode_(false), groupMode_(false), beginHeaderLength_(13), pageIndex_(0), pageCount_(0), activePage_(0),
+      bundleNextPage_(0), bundleActivePage_(0), bundlePageCount_(0),
+      groupStart_(0), groupCount_(0), groupOffset_(0),
+      bundleGroupStart_(0), bundleGroupCount_(0), bundleTransactionActive_(false),
+      expectedCrc_(0), runningCrc_(0xFFFFFFFFu),
+      dataLength_(0), dataReceived_(0),
+      nextSeq_(0), rowY_(0), bufIdx_(0) {
+}
+
+void SidecarFrameProtocol::onWrite(const uint8_t* /*data*/, uint16_t /*len*/) {
+}
+
+bool SidecarFrameProtocol::inTransfer() const {
+    return false;
+}
+
+bool SidecarFrameProtocol::consumeFrameComplete() {
+    return false;
+}
+
+void SidecarFrameProtocol::reset() {
+}
+
+#endif
diff --git a/src/SidecarFrameProtocol.h b/src/SidecarFrameProtocol.h
new file mode 100644
index 00000000..01a1d012
--- /dev/null
+++ b/src/SidecarFrameProtocol.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+class SidecarSink;
+
+// DESIGN INTENT: Parse bounded v1-v4 frame packets with fixed memory, strict dimensions,
+// immutable transaction metadata, sequencing, and checksums; publish completion only after commit.
+
+// Reassembles a 1bpp image sent as BEGIN / DATA... / END and blits it through a SidecarSink.
+class SidecarFrameProtocol {
+ public:
+  static constexpr uint8_t kOpBegin = 0x01;
+  static constexpr uint8_t kOpData  = 0x02;
+  static constexpr uint8_t kOpEnd   = 0x03;
+  static constexpr uint8_t kOpClear = 0x04;
+  static constexpr uint8_t kOpBeginPage = 0x05;
+  static constexpr uint8_t kOpBeginGroupPage = 0x08;
+
+  explicit SidecarFrameProtocol(SidecarSink* sink);
+
+  // Feed one transport write. Must be called from the task that owns the display: END presents,
+  // and present() blocks on the panel waveform.
+  void onWrite(const uint8_t* data, uint16_t len);
+
+  // True between a valid BEGIN and its END.
+  bool inTransfer() const;
+
+  // Return true exactly once after a complete frame has been presented.
+  bool consumeFrameComplete();
+
+  // Abandon any transfer in progress. Call on disconnect so a half-sent frame cannot be
+  // completed by the next client's bytes.
+  void reset();
+
+ private:
+  void abortTransfer();
+
+  static constexpr uint16_t kMaxRowBytes = 128;
+
+  // BEGIN_PAGE adds bundle metadata; BEGIN_GROUP_PAGE adds a bounded catalog range.
+  static constexpr uint8_t kMaxHdrBytes = 23;
+
+  SidecarSink* sink_;
+  bool frameComplete_;
+
+  // Byte-by-byte parse state machine. In every state except Idle, the opcode
+  // byte has already been consumed and hdrIdx_ counts how many subsequent
+  // header bytes have been collected into rowBuf_.
+  enum class State : uint8_t {
+    Idle,         // Awaiting BEGIN or CLEAR opcode
+    Begin,        // Collecting 13 bytes: u16 x, y, w, h, u8 format, u32 length
+    TransferWait, // In a transfer; awaiting DATA or END opcode
+    DataHdr,      // Collecting 2 bytes: u16 seq
+    Data,         // Accumulating payload bytes into rowBuf_, blitting per row
+    End,          // Collecting 1 byte: u8 refresh
+    Clear,        // Collecting 1 byte: u8 colour
+  };
+  State state_;
+  uint16_t hdrIdx_;
+
+  // Transfer parameters parsed from BEGIN.
+  uint16_t x_;
+  uint16_t y_;
+  uint16_t w_;
+  uint16_t h_;
+  uint8_t format_;
+  bool pageMode_;
+  bool groupMode_;
+  uint8_t beginHeaderLength_;
+  uint8_t pageIndex_;
+  uint8_t pageCount_;
+  uint8_t activePage_;
+  uint8_t bundleNextPage_;
+  uint8_t bundleActivePage_;
+  uint8_t bundlePageCount_;
+  uint8_t groupStart_;
+  uint8_t groupCount_;
+  uint8_t groupOffset_;
+  uint8_t bundleGroupStart_;
+  uint8_t bundleGroupCount_;
+  bool bundleTransactionActive_;
+  uint32_t expectedCrc_;
+  uint32_t runningCrc_;
+  uint32_t dataLength_;     // Total DATA payload bytes expected
+  uint32_t dataReceived_;   // DATA payload bytes received so far
+  uint16_t nextSeq_;        // Next expected DATA seq number
+  uint16_t rowY_;           // y coordinate for the next blit
+  uint16_t bufIdx_;         // Bytes accumulated in rowBuf_ for the current row
+
+  // Accumulates one row of DATA payload at a time. Fixed size, never allocated.
+  uint8_t rowBuf_[kMaxRowBytes];
+
+  // Header bytes are collected HERE, never in rowBuf_. Rows span multiple DATA packets, so a
+  // DATA header arriving mid-row would otherwise overwrite the first two bytes of that row.
+  uint8_t hdrBuf_[kMaxHdrBytes];
+};
diff --git a/src/SidecarLink.cpp b/src/SidecarLink.cpp
new file mode 100644
index 00000000..ea364ea6
--- /dev/null
+++ b/src/SidecarLink.cpp
@@ -0,0 +1,810 @@
+#include "SidecarSink.h"
+#include "SidecarFrameProtocol.h"
+#include "SidecarCollectionsV5Store.h"
+#include "SidecarCollectionsV5Transfer.h"
+
+// DESIGN INTENT: Keep BLE callbacks nonblocking, advertise exact protocol capabilities, deliver
+// completion notifications from the loop task, and reserve Up/Down for cached-page navigation only
+// while Sidecar owns the screen. Malformed traffic or missing storage must leave the prior page valid.
+
+#ifndef SIDECAR_LINK
+
+extern "C" void sidecarLinkBegin() {}
+extern "C" void sidecarLinkPoll() {}
+extern "C" bool sidecarLinkOwnsScreen() { return false; }
+extern "C" bool sidecarLinkConsumeActivity() { return false; }
+extern "C" bool sidecarLinkHandleButtons(void*) { return false; }
+extern "C" void sidecarLinkResumeScreenOwnership() {}
+extern "C" bool sidecarLinkRestoreStoredPage() { return false; }
+extern "C" bool sidecarLinkAdvanceStoredPage() { return false; }
+
+#else
+
+#include <Logging.h>
+#include <NimBLEDevice.h>
+#include <HalPowerManager.h>
+#include <Preferences.h>
+#include "MappedInputManager.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+
+// The contract with the phone. These UUIDs are load-bearing; a typo means the
+// Android side never finds the device.
+constexpr const char* kServiceUuid = "6e6b1a00-9f1d-4b7a-9c2e-1f0a2d3c4b5a";
+constexpr const char* kRxCharUuid = "6e6b1a01-9f1d-4b7a-9c2e-1f0a2d3c4b5a";
+constexpr const char* kInfoCharUuid = "6e6b1a02-9f1d-4b7a-9c2e-1f0a2d3c4b5a";
+constexpr const char* kStatusCharUuid = "6e6b1a03-9f1d-4b7a-9c2e-1f0a2d3c4b5a";
+constexpr const char* kInventoryCharUuid = "6e6b1a04-9f1d-4b7a-9c2e-1f0a2d3c4b5a";
+constexpr const char* kDeviceName = "EinkSidecar";
+
+// Fixed-capacity staging between the NimBLE host task and the loop task.
+// The hot path (onWrite) must not allocate, log, or block.
+constexpr uint16_t kMaxPayload = 514;   // ATT MTU 517 minus its three-byte write overhead
+constexpr uint16_t kRingSlots = 32;      // Bounded backlog while the panel blocks; background sender paces DATA >=25 ms.
+static portMUX_TYPE generationMux_ = portMUX_INITIALIZER_UNLOCKED;
+static uint32_t connectionGeneration_ = 0;
+
+uint32_t advanceConnectionGeneration() {
+  portENTER_CRITICAL(&generationMux_);
+  const uint32_t value = ++connectionGeneration_;
+  portEXIT_CRITICAL(&generationMux_);
+  return value;
+}
+
+uint32_t currentConnectionGeneration() {
+  portENTER_CRITICAL(&generationMux_);
+  const uint32_t value = connectionGeneration_;
+  portEXIT_CRITICAL(&generationMux_);
+  return value;
+}
+
+struct RingItem {
+  uint8_t data[kMaxPayload];
+  uint16_t len;          // bytes stored (after truncation)
+  uint16_t originalLen;  // bytes the central tried to send
+  uint32_t generation;   // changes at every connect/disconnect boundary
+  bool truncated;
+};
+
+class RingBuffer {
+ public:
+  bool push(const uint8_t* p, uint16_t n, uint32_t generation) {
+    if (p == nullptr || n == 0) {
+      portENTER_CRITICAL(&mux_);
+      ++overflowCount_;  // Account for malformed callback input on the loop task.
+      portEXIT_CRITICAL(&mux_);
+      return false;
+    }
+    const uint16_t originalLen = n;
+    if (n > kMaxPayload) {
+      n = kMaxPayload;
+    }
+    const bool wasTruncated = (originalLen > n);
+
+    portENTER_CRITICAL(&mux_);
+    const uint16_t next = (head_ + 1) % kRingSlots;
+    if (next == tail_) {
+      ++overflowCount_;
+      portEXIT_CRITICAL(&mux_);
+      return false;
+    }
+    RingItem& slot = slots_[head_];
+    std::memcpy(slot.data, p, n);
+    slot.len = n;
+    slot.originalLen = originalLen;
+    slot.generation = generation;
+    slot.truncated = wasTruncated;
+    head_ = next;
+    portEXIT_CRITICAL(&mux_);
+    return true;
+  }
+
+  bool pop(RingItem* out) {
+    portENTER_CRITICAL(&mux_);
+    if (head_ == tail_) {
+      portEXIT_CRITICAL(&mux_);
+      return false;
+    }
+    *out = slots_[tail_];
+    tail_ = (tail_ + 1) % kRingSlots;
+    portEXIT_CRITICAL(&mux_);
+    return true;
+  }
+
+  uint32_t drainOverflowCount() {
+    portENTER_CRITICAL(&mux_);
+    const uint32_t c = overflowCount_;
+    overflowCount_ = 0;
+    portEXIT_CRITICAL(&mux_);
+    return c;
+  }
+
+  void clear() {
+    portENTER_CRITICAL(&mux_);
+    tail_ = head_;
+    portEXIT_CRITICAL(&mux_);
+  }
+
+ private:
+  RingItem slots_[kRingSlots];
+  volatile uint16_t head_ = 0;
+  volatile uint16_t tail_ = 0;
+  uint32_t overflowCount_ = 0;
+  portMUX_TYPE mux_ = portMUX_INITIALIZER_UNLOCKED;
+};
+
+static RingBuffer ringBuffer;
+
+// Server callbacks also run on the NimBLE host task, so connect/disconnect
+// events are queued here and logged (and any failure reported) from poll().
+enum class ServerEventType : uint8_t { kConnect, kDisconnect, kMtuChange };
+
+struct ServerEvent {
+  ServerEventType type;
+  uint16_t mtu;        // valid for kConnect and kMtuChange
+  int reason;          // valid for kDisconnect
+  bool restartOk;      // valid for kDisconnect
+};
+
+constexpr uint16_t kServerEventSlots = 16;
+
+class ServerEventRing {
+ public:
+  bool push(ServerEventType type, uint16_t mtu, int reason, bool restartOk) {
+    portENTER_CRITICAL(&mux_);
+    const uint16_t next = (head_ + 1) % kServerEventSlots;
+    if (next == tail_) {
+      ++overflowCount_;
+      portEXIT_CRITICAL(&mux_);
+      return false;
+    }
+    slots_[head_] = {type, mtu, reason, restartOk};
+    head_ = next;
+    portEXIT_CRITICAL(&mux_);
+    return true;
+  }
+
+  bool pop(ServerEvent* out) {
+    portENTER_CRITICAL(&mux_);
+    if (head_ == tail_) {
+      portEXIT_CRITICAL(&mux_);
+      return false;
+    }
+    *out = slots_[tail_];
+    tail_ = (tail_ + 1) % kServerEventSlots;
+    portEXIT_CRITICAL(&mux_);
+    return true;
+  }
+
+  uint32_t drainOverflowCount() {
+    portENTER_CRITICAL(&mux_);
+    const uint32_t c = overflowCount_;
+    overflowCount_ = 0;
+    portEXIT_CRITICAL(&mux_);
+    return c;
+  }
+
+ private:
+  ServerEvent slots_[kServerEventSlots];
+  volatile uint16_t head_ = 0;
+  volatile uint16_t tail_ = 0;
+  uint32_t overflowCount_ = 0;
+  portMUX_TYPE mux_ = portMUX_INITIALIZER_UNLOCKED;
+};
+
+static ServerEventRing serverEventRing;
+
+class SidecarRxCallbacks : public NimBLECharacteristicCallbacks {
+ public:
+  void onWrite(NimBLECharacteristic* ch, NimBLEConnInfo& connInfo) override {
+    const NimBLEAttValue& v = ch->getValue();
+    const uint8_t* p = v.data();
+    const uint16_t n = v.length();
+    ringBuffer.push(p, n, currentConnectionGeneration());
+  }
+};
+
+class SidecarServerCallbacks : public NimBLEServerCallbacks {
+ public:
+  void onConnect(NimBLEServer* server, NimBLEConnInfo& connInfo) override {
+    advanceConnectionGeneration();
+    // Defer logging to the loop task; just capture the MTU.
+    serverEventRing.push(ServerEventType::kConnect, connInfo.getMTU(), 0, false);
+  }
+
+  void onDisconnect(NimBLEServer* server, NimBLEConnInfo& connInfo, int reason) override {
+    advanceConnectionGeneration();
+    // Defer stack work and logging to poll(); the host callback only records the event.
+    serverEventRing.push(ServerEventType::kDisconnect, 0, reason, false);
+  }
+
+  void onMTUChange(uint16_t MTU, NimBLEConnInfo& connInfo) override {
+    // Runs on the NimBLE host task after the ATT MTU exchange completes.
+    // This is the only place the negotiated MTU is reported; defer the
+    // actual logging to the loop task via the event ring.
+    serverEventRing.push(ServerEventType::kMtuChange, MTU, 0, false);
+  }
+};
+
+static bool linkStarted_ = false;
+static bool linkFailed_ = false;
+static bool screenOwned_ = false;
+static volatile bool activitySinceLastPoll_ = false;
+static NimBLEServer* server_ = nullptr;
+static NimBLECharacteristic* rxChar_ = nullptr;
+static NimBLECharacteristic* infoChar_ = nullptr;
+static NimBLECharacteristic* statusChar_ = nullptr;
+static NimBLECharacteristic* inventoryChar_ = nullptr;
+static uint32_t completionCounter_ = 0;
+static uint32_t parserGeneration_ = 0;
+static bool completionNotifyPending_ = false;
+static uint32_t nextNotifyAttemptMs_ = 0;
+static uint8_t completionNotifyAttempts_ = 0;
+static uint32_t nextLocalPageTurnMs_ = 0;
+static uint32_t nextAdvertisingCheckMs_ = 0;
+static uint32_t localPageDwellMs_ = 30000;  // Legacy phones retain their established cadence.
+static bool cadenceLoaded_ = false;
+static bool pendingCadence_ = false;
+static uint8_t completedCycles_ = 0;
+static uint32_t pendingCadenceMs_ = 30000;
+
+void loadCadence() {
+  if (cadenceLoaded_) return;
+  cadenceLoaded_ = true;
+  Preferences prefs;
+  if (prefs.begin("sidecar", true)) {
+    const uint32_t saved = prefs.getUInt("pageDwell", 30000);
+    if (saved == 0 || (saved >= 1000 && saved <= 300000)) localPageDwellMs_ = saved;
+    prefs.end();
+  }
+}
+
+void scheduleLocalPage() {
+  loadCadence();
+  nextLocalPageTurnMs_ = localPageDwellMs_ == 0 ? 0 : millis() + localPageDwellMs_;
+}
+constexpr uint32_t kAdvertisingCheckMs = 10000;
+
+static SidecarFrameProtocol& frameProtocol() {
+  static SidecarFrameProtocol instance(sidecarSinkInstance());
+  return instance;
+}
+static sidecar::v5::Transfer& collectionTransfer() {
+  SidecarSink* sink = sidecarSinkInstance();
+  static sidecar::v5::Transfer instance(sink ? sink->width() : 0, sink ? sink->height() : 0);
+  return instance;
+}
+
+void setStatusValue(uint8_t state) {
+  if (statusChar_ == nullptr) return;
+  uint8_t value[5] = {
+      state,
+      static_cast<uint8_t>(completionCounter_ & 0xff),
+      static_cast<uint8_t>((completionCounter_ >> 8) & 0xff),
+      static_cast<uint8_t>((completionCounter_ >> 16) & 0xff),
+      static_cast<uint8_t>((completionCounter_ >> 24) & 0xff),
+  };
+  statusChar_->setValue(value, sizeof(value));
+}
+
+bool buildInventoryValue(uint8_t* value, size_t capacity, size_t& length, bool& hasRoot) {
+  sidecar::v5::Store store;
+  sidecar::v5::RootIndex root{};
+  sidecar::v5::CollectionManifest manifests[sidecar::v5::kMaxCollections]{};
+  sidecar::v5::Selection selection{};
+  sidecar::v5::SessionJournal session{};
+  hasRoot = store.loadNewestRoot(root);
+  if (hasRoot) {
+    for (uint8_t i = 0; i < root.entryCount; ++i) {
+      if (!store.loadCollectionManifest(root.entries[i].collectionId,
+                                        root.entries[i].expectedGeneration, manifests[i])) {
+        hasRoot = false;
+        break;
+      }
+    }
+  }
+  const bool hasSelection = hasRoot && store.loadSelection(selection);
+  const bool hasSession = store.loadNewestSession(session);
+  return sidecar::v5::encodeInventory(hasRoot ? &root : nullptr,
+                                     hasRoot ? manifests : nullptr,
+                                     hasSelection ? &selection : nullptr,
+                                     hasSession ? &session : nullptr,
+                                     value, capacity, length);
+}
+
+}  // namespace
+
+extern "C" void sidecarLinkBegin() {
+  if (linkStarted_ || linkFailed_) {
+    return;
+  }
+
+  const uint32_t heapBefore = ESP.getFreeHeap();
+
+  if (sidecarSinkInstance() == nullptr) {
+    LOG_ERR("SIDECAR", "display sink unavailable; BLE link not started");
+    linkFailed_ = true;
+    return;
+  }
+
+  NimBLEDevice::init(kDeviceName);
+
+  // Ask for the biggest ATT MTU the stack will offer. The central still decides - this only
+  // sets what we advertise as acceptable. Measured 256 on 2026-08-13 and 23 on 2026-08-21 with
+  // no request at all, which is why stage 3 cannot size its chunks until this is deliberate.
+  constexpr uint16_t kPreferredMtu = 517;
+  const bool mtuSet = NimBLEDevice::setMTU(kPreferredMtu);
+  LOG_INF("SIDECAR", "preferred mtu request %u accepted=%d",
+          static_cast<unsigned>(kPreferredMtu), mtuSet ? 1 : 0);
+
+  server_ = NimBLEDevice::createServer();
+  if (!server_) {
+    LOG_ERR("SIDECAR", "createServer failed");
+    linkFailed_ = true;
+    return;
+  }
+  server_->setCallbacks(new SidecarServerCallbacks());
+
+  NimBLEService* service = server_->createService(kServiceUuid);
+  if (!service) {
+    LOG_ERR("SIDECAR", "createService failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  rxChar_ = service->createCharacteristic(
+      kRxCharUuid,
+      NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::WRITE_NR);
+  if (!rxChar_) {
+    LOG_ERR("SIDECAR", "createCharacteristic failed");
+    linkFailed_ = true;
+    return;
+  }
+  rxChar_->setCallbacks(new SidecarRxCallbacks());
+
+  // INFO characteristic: publishes the slate geometry so the phone renders at the right size.
+  // Set once from the sink; reads run on the host task so the value must already be there.
+  infoChar_ = service->createCharacteristic(kInfoCharUuid, NIMBLE_PROPERTY::READ);
+  if (!infoChar_) {
+    LOG_ERR("SIDECAR", "createCharacteristic (info) failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  SidecarSink* sink = sidecarSinkInstance();
+  const uint16_t w = sink ? sink->width() : 0;
+  const uint16_t h = sink ? sink->height() : 0;
+  const uint16_t maxChunk = kMaxPayload - 3;  // DATA opcode + u16 sequence header
+
+  uint8_t buf[18];
+  buf[0] = static_cast<uint8_t>(w & 0xFF);
+  buf[1] = static_cast<uint8_t>((w >> 8) & 0xFF);
+  buf[2] = static_cast<uint8_t>(h & 0xFF);
+  buf[3] = static_cast<uint8_t>((h >> 8) & 0xFF);
+  buf[4] = 1;      // bpp
+  buf[5] = 0;      // rotation
+  buf[6] = static_cast<uint8_t>(maxChunk & 0xFF);
+  buf[7] = static_cast<uint8_t>((maxChunk >> 8) & 0xFF);
+  buf[8] = 5;      // protocolVer low: read-only collection discovery plus v4 writes
+  buf[9] = 0;      // protocolVer high
+  buf[10] = 63;  // cadence, deferred handoff, grouped updates, collections, DEFLATE, and 1-bit PNG
+  buf[11] = SidecarSink::kMaxStoredPages;
+  buf[12] = SidecarSink::kMaxGroupPages;  // Keep replacement inside measured BLE connection window.
+  buf[13] = sidecar::v5::kMaxCollections;
+  buf[14] = sidecar::v5::kMaxPagesPerCollection;
+  buf[15] = static_cast<uint8_t>(sidecar::v5::kMaxPublishedPages & 0xff);
+  buf[16] = static_cast<uint8_t>(sidecar::v5::kMaxPublishedPages >> 8);
+  buf[17] = sidecar::v5::kMaxNameBytes;
+  infoChar_->setValue(buf, sizeof(buf));
+
+  inventoryChar_ = service->createCharacteristic(kInventoryCharUuid, NIMBLE_PROPERTY::READ);
+  if (!inventoryChar_) {
+    LOG_ERR("SIDECAR", "createCharacteristic (inventory) failed");
+    linkFailed_ = true;
+    return;
+  }
+  uint8_t inventory[sidecar::v5::kInventoryMaxSize];
+  size_t inventoryLength = 0;
+  bool hasV5Root = false;
+  if (!buildInventoryValue(inventory, sizeof(inventory), inventoryLength, hasV5Root)) {
+    LOG_ERR("SIDECAR", "inventory snapshot failed");
+    linkFailed_ = true;
+    return;
+  }
+  inventoryChar_->setValue(inventory, inventoryLength);
+
+  statusChar_ = service->createCharacteristic(
+      kStatusCharUuid,
+      NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::NOTIFY);
+  if (!statusChar_) {
+    LOG_ERR("SIDECAR", "createCharacteristic (status) failed");
+    linkFailed_ = true;
+    return;
+  }
+  setStatusValue(0);
+
+  // NimBLE-Arduino 2.x registers all configured services when the server starts.
+  if (!server_->start()) {
+    LOG_ERR("SIDECAR", "GATT server start failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  LOG_INF("SIDECAR", "info w=%u h=%u bpp=1 maxChunk=%u ver=5 maxPages=%u groupPages=%u v5Root=%u",
+          static_cast<unsigned>(w),
+          static_cast<unsigned>(h),
+          static_cast<unsigned>(maxChunk),
+          static_cast<unsigned>(SidecarSink::kMaxStoredPages),
+          static_cast<unsigned>(SidecarSink::kMaxGroupPages), hasV5Root ? 1u : 0u);
+
+  NimBLEAdvertising* adv = NimBLEDevice::getAdvertising();
+  if (!adv) {
+    LOG_ERR("SIDECAR", "getAdvertising failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  // The 128-bit service UUID must stay in the primary advert so the phone's
+  // service-filtered scan can match it.
+  if (!adv->addServiceUUID(kServiceUuid)) {
+    LOG_ERR("SIDECAR", "addServiceUUID failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  // The legacy advert is only 31 bytes and cannot hold both the UUID and the
+  // name. Put the name in the scan response instead; Android still reports it.
+  adv->enableScanResponse(true);
+
+  NimBLEAdvertisementData scanResponse;
+  if (!scanResponse.setName(kDeviceName)) {
+    LOG_ERR("SIDECAR", "setName failed");
+    linkFailed_ = true;
+    return;
+  }
+  if (!adv->setScanResponseData(scanResponse)) {
+    LOG_ERR("SIDECAR", "setScanResponseData failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  if (!adv->start()) {
+    LOG_ERR("SIDECAR", "advertising start failed");
+    linkFailed_ = true;
+    return;
+  }
+
+  // Hold the CPU at its normal frequency for as long as the link is up.
+  // Without this, CrossPoint drops to 10 MHz after 3 s idle and the BLE
+  // controller stops advertising (measured: advert disappears at ~6.7 s).
+  // Lock is non-copyable/non-movable, so a function-local static is the only
+  // shape that outlives this function.
+  static HalPowerManager::Lock sidecarPowerLock;
+  LOG_INF("SIDECAR", "power-saving lock held");
+
+  linkStarted_ = true;
+  const uint32_t heapAfter = ESP.getFreeHeap();
+  LOG_INF("SIDECAR",
+          "advertising started name=EinkSidecar uuid=%s heapBefore=%u heapAfter=%u",
+          kServiceUuid,
+          static_cast<unsigned>(heapBefore),
+          static_cast<unsigned>(heapAfter));
+}
+
+extern "C" void sidecarLinkPoll() {
+  if (!linkStarted_) {
+    return;
+  }
+
+  if (static_cast<int32_t>(millis() - nextAdvertisingCheckMs_) >= 0) {
+    nextAdvertisingCheckMs_ = millis() + kAdvertisingCheckMs;
+    NimBLEAdvertising* advertising = NimBLEDevice::getAdvertising();
+    if (server_ != nullptr && server_->getConnectedCount() == 0 && advertising != nullptr &&
+        !advertising->isAdvertising()) {
+      const bool restarted = advertising->start();
+      LOG_INF("SIDECAR", "advertising watchdog restart accepted=%d", restarted ? 1 : 0);
+    }
+  }
+
+  const uint32_t dropped = ringBuffer.drainOverflowCount();
+  if (dropped > 0) {
+    LOG_INF("SIDECAR", "dropped %u writes", static_cast<unsigned>(dropped));
+    ringBuffer.clear();
+    frameProtocol().reset();
+    collectionTransfer().onDisconnect();
+    completionNotifyPending_ = false;
+    completionNotifyAttempts_ = 0;
+  }
+
+  const uint32_t droppedEvents = serverEventRing.drainOverflowCount();
+  if (droppedEvents > 0) {
+    LOG_INF("SIDECAR", "dropped %u connection events", static_cast<unsigned>(droppedEvents));
+    ringBuffer.clear();
+    frameProtocol().reset();
+    collectionTransfer().onDisconnect();
+    completionNotifyPending_ = false;
+    completionNotifyAttempts_ = 0;
+    // Reconcile the observable state directly with NimBLE if the callback queue saturated.
+    // Connection generation already advances in the callback even when its event cannot queue.
+    setStatusValue(0);
+    pendingCadence_ = false;
+    activitySinceLastPoll_ = false;
+    // The stored catalog remains valid. Re-establish local ownership/timing from that durable
+    // state, independent of which connect/disconnect event was lost.
+    SidecarSink* overflowSink = sidecarSinkInstance();
+    screenOwned_ = overflowSink != nullptr && overflowSink->hasStoredPages();
+    if (screenOwned_) scheduleLocalPage();
+    else nextLocalPageTurnMs_ = 0;
+    // A disconnected server must resume advertising even if its event was the one lost.
+    if (server_ != nullptr && server_->getConnectedCount() == 0) {
+      if (!NimBLEDevice::startAdvertising()) {
+        LOG_ERR("SIDECAR", "advertising recovery after event overflow failed");
+      }
+    }
+  }
+
+  ServerEvent evt;
+  while (serverEventRing.pop(&evt)) {
+    if (evt.type == ServerEventType::kConnect) {
+      setStatusValue(0);
+      const uint16_t mtu = evt.mtu;
+      char line[256];
+      std::snprintf(line, sizeof(line),
+                    "central connected mtu=%u (pre-negotiation default; see mtu negotiated=)",
+                    static_cast<unsigned>(mtu));
+      LOG_INF("SIDECAR", "%s", line);
+    } else if (evt.type == ServerEventType::kMtuChange) {
+      const uint16_t mtu = evt.mtu;
+      const uint16_t preferred = NimBLEDevice::getMTU();
+      const uint16_t usable = (mtu > 3) ? (mtu - 3) : 0;
+      char line[256];
+      std::snprintf(line, sizeof(line),
+                    "mtu negotiated=%u preferred=%u usable=%u",
+                    static_cast<unsigned>(mtu),
+                    static_cast<unsigned>(preferred),
+                    static_cast<unsigned>(usable));
+      LOG_INF("SIDECAR", "%s", line);
+    } else {
+      LOG_INF("SIDECAR", "central disconnected reason=%d", evt.reason);
+      setStatusValue(0);
+      // Drop every queued write at the connection boundary. A newly connected phone may need
+      // to retry, but its bytes can never complete the disconnected client's partial transfer.
+      ringBuffer.clear();
+      frameProtocol().reset();
+      collectionTransfer().onDisconnect();
+      completionNotifyPending_ = false;
+      completionNotifyAttempts_ = 0;
+      const bool restarted = NimBLEDevice::startAdvertising();
+      if (restarted) {
+        LOG_INF("SIDECAR", "advertising restarted");
+      } else {
+        LOG_ERR("SIDECAR", "advertising restart failed");
+      }
+    }
+  }
+
+  const uint32_t activeGeneration = currentConnectionGeneration();
+  if (activeGeneration != parserGeneration_) {
+    frameProtocol().reset();
+    collectionTransfer().onDisconnect();
+    parserGeneration_ = activeGeneration;
+    pendingCadence_ = false;
+  }
+
+  auto finishPresentation = []() {
+      if (pendingCadence_) {
+        loadCadence();
+        if (localPageDwellMs_ != pendingCadenceMs_) {
+          Preferences prefs;
+          if (prefs.begin("sidecar", false)) {
+            if (prefs.putUInt("pageDwell", pendingCadenceMs_) != sizeof(uint32_t))
+              LOG_ERR("SIDECAR", "page cadence persistence failed");
+            prefs.end();
+          } else LOG_ERR("SIDECAR", "page cadence storage unavailable");
+        }
+        localPageDwellMs_ = pendingCadenceMs_;
+        pendingCadence_ = false;
+        LOG_INF("SIDECAR", "page dwell applied ms=%lu", static_cast<unsigned long>(localPageDwellMs_));
+      }
+      ++completionCounter_;
+      setStatusValue(1);
+      completionNotifyPending_ = true;
+      nextNotifyAttemptMs_ = 0;
+      completionNotifyAttempts_ = 0;
+      screenOwned_ = true;
+      activitySinceLastPoll_ = true;
+      completedCycles_ = 0;
+      scheduleLocalPage();
+  };
+
+  RingItem item;
+  while (ringBuffer.pop(&item)) {
+    if (item.generation != activeGeneration) continue;
+    if (item.truncated) {
+      LOG_INF("SIDECAR",
+              "write truncated from %u to %u bytes",
+              static_cast<unsigned>(item.originalLen),
+              static_cast<unsigned>(item.len));
+      frameProtocol().reset();
+      continue;
+    }
+    if (item.len > 0 && item.data[0] == 0x07) {
+      SidecarSink* sink = sidecarSinkInstance();
+      if (sink != nullptr && item.len == 2 && item.data[1] == 2 && !frameProtocol().inTransfer()) {
+        sink->deferBundleUntilCycle(true);
+      } else {
+        frameProtocol().reset();
+        pendingCadence_ = false;
+        LOG_ERR("SIDECAR", "invalid background bundle control");
+      }
+      continue;
+    }
+    if (item.len > 0 && item.data[0] == 0x06) {
+      // A dedicated ATT control packet, never part of the streaming frame parser.
+      if (item.len != 5 || frameProtocol().inTransfer()) {
+        frameProtocol().reset();
+        pendingCadence_ = false;
+        LOG_ERR("SIDECAR", "invalid page cadence control");
+        continue;
+      }
+      const uint32_t ms = static_cast<uint32_t>(item.data[1]) |
+          (static_cast<uint32_t>(item.data[2]) << 8) |
+          (static_cast<uint32_t>(item.data[3]) << 16) |
+          (static_cast<uint32_t>(item.data[4]) << 24);
+      pendingCadence_ = ms == 0 || (ms >= 1000 && ms <= 300000);
+      if (pendingCadence_) pendingCadenceMs_ = ms;
+      else {
+        frameProtocol().reset();
+        LOG_ERR("SIDECAR", "page cadence out of range");
+      }
+      continue;
+    }
+    if (item.len > 0 && collectionTransfer().handles(item.data[0])) {
+      if (frameProtocol().inTransfer() || !collectionTransfer().onPacket(item.data, item.len)) {
+        LOG_ERR("SIDECAR", "v5 collection packet rejected opcode=0x%02X", item.data[0]);
+      } else {
+        activitySinceLastPoll_ = true;
+        // DATA and BEGIN_PAGE do not change the durable inventory. Rebuilding it here performs
+        // several FAT reads for every bitmap chunk, stalls the loop, and can overflow the BLE
+        // receive ring. Refresh only after operations that change observable session/root state.
+        const uint8_t opcode = item.data[0];
+        if (opcode == 0x03 || opcode == 0x0B || opcode == 0x0C || opcode == 0x0D || opcode == 0x0E) {
+          uint8_t inventory[sidecar::v5::kInventoryMaxSize]; size_t inventoryLength = 0; bool hasRoot = false;
+          if (inventoryChar_ != nullptr &&
+              buildInventoryValue(inventory, sizeof(inventory), inventoryLength, hasRoot))
+            inventoryChar_->setValue(inventory, inventoryLength);
+        }
+        if (opcode == 0x0C) {
+          SidecarSink* sink = sidecarSinkInstance();
+          if (sink != nullptr && sink->showStoredPage(0)) {
+            screenOwned_ = true;
+            completedCycles_ = 0;
+            scheduleLocalPage();
+            LOG_INF("SIDECAR", "v5 commit restored screen ownership");
+          } else {
+            LOG_ERR("SIDECAR", "v5 commit could not restore screen ownership");
+          }
+        }
+      }
+      continue;
+    }
+    frameProtocol().onWrite(item.data, item.len);
+    const bool complete = frameProtocol().consumeFrameComplete();
+    if (complete) {
+      SidecarSink* sink = sidecarSinkInstance();
+      if (sink == nullptr || !sink->hasPendingBundle()) finishPresentation();
+    } else if (frameProtocol().inTransfer()) {
+      // Keep the device awake only for a packet that advanced a valid in-progress transfer.
+      activitySinceLastPoll_ = true;
+    }
+  }
+
+  if (sidecarSinkInstance() != nullptr && sidecarSinkInstance()->hasPendingBundle())
+    activitySinceLastPoll_ = true;
+
+  if (completionNotifyPending_ &&
+      (nextNotifyAttemptMs_ == 0 || static_cast<int32_t>(millis() - nextNotifyAttemptMs_) >= 0)) {
+    const bool notified = statusChar_->notify();
+    if (notified || completionNotifyAttempts_ == 0) {
+      LOG_INF("SIDECAR", "frame completion notify accepted=%d", notified ? 1 : 0);
+    }
+    if (notified) {
+      completionNotifyPending_ = false;
+    } else if (++completionNotifyAttempts_ >= 8) {
+      // The panel commit succeeded, but delivery did not. Publish a terminal failure state and
+      // let the phone time out/retry instead of leaving a readable success value behind.
+      setStatusValue(2);
+      completionNotifyPending_ = false;
+      LOG_ERR("SIDECAR", "frame completion notification failed after 8 attempts");
+    } else {
+      nextNotifyAttemptMs_ = millis() + 250;
+    }
+  }
+
+  if (screenOwned_ && nextLocalPageTurnMs_ != 0 &&
+      static_cast<int32_t>(millis() - nextLocalPageTurnMs_) >= 0 &&
+      !collectionTransfer().inTransfer() &&
+      (server_ == nullptr || server_->getConnectedCount() == 0 ||
+       !frameProtocol().inTransfer() ||
+       (sidecarSinkInstance() != nullptr && sidecarSinkInstance()->backgroundReceptionSafe()))) {
+    SidecarSink* sink = sidecarSinkInstance();
+    const bool boundary = sink != nullptr && sink->atLastStoredPage();
+    if (boundary && completedCycles_ >= 2 && sink->hasPendingBundle()) {
+      if (sink->activatePendingBundle()) {
+        LOG_INF("SIDECAR", "background handoff after two or more cycles");
+        finishPresentation();
+      } else {
+        LOG_ERR("SIDECAR", "background handoff failed; retaining previous bundle");
+        frameProtocol().reset();
+        pendingCadence_ = false;
+        setStatusValue(2);
+        scheduleLocalPage();
+      }
+    } else if (sink != nullptr && sink->showStoredPage(1)) {
+      if (boundary && completedCycles_ < 2) ++completedCycles_;
+      scheduleLocalPage();
+    } else {
+      nextLocalPageTurnMs_ = 0;
+    }
+  }
+}
+
+extern "C" bool sidecarLinkOwnsScreen() {
+  return screenOwned_;
+}
+
+extern "C" bool sidecarLinkConsumeActivity() {
+  const bool had = activitySinceLastPoll_;
+  activitySinceLastPoll_ = false;
+  return had;
+}
+
+extern "C" bool sidecarLinkHandleButtons(void* inputPtr) {
+  if (!screenOwned_ || inputPtr == nullptr) return false;
+  auto* input = static_cast<MappedInputManager*>(inputPtr);
+  int8_t delta = 0;
+  if (input->wasPressed(MappedInputManager::Button::Up)) delta = -1;
+  else if (input->wasPressed(MappedInputManager::Button::Down)) delta = 1;
+  if (delta == 0) return false;
+  SidecarSink* sink = sidecarSinkInstance();
+  if (sink == nullptr) { screenOwned_ = false; return false; }
+  const bool shown = sink->showStoredPage(delta);
+  if (shown) {
+    activitySinceLastPoll_ = true;
+    scheduleLocalPage();
+  }
+  else screenOwned_ = false;
+  return shown;
+}
+
+extern "C" void sidecarLinkResumeScreenOwnership() {
+  SidecarSink* sink = sidecarSinkInstance();
+  if (sink != nullptr && sink->hasStoredPages()) {
+    screenOwned_ = true;
+    scheduleLocalPage();
+  }
+}
+
+extern "C" bool sidecarLinkRestoreStoredPage() {
+  SidecarSink* sink = sidecarSinkInstance();
+  if (sink == nullptr || !sink->showStoredPage(0)) return false;
+  screenOwned_ = true;
+  activitySinceLastPoll_ = true;
+  scheduleLocalPage();
+  return true;
+}
+
+extern "C" bool sidecarLinkAdvanceStoredPage() {
+  loadCadence();
+  if (localPageDwellMs_ == 0) return false;  // Fixed recipes remain pinned on timer wake too.
+  SidecarSink* sink = sidecarSinkInstance();
+  if (sink == nullptr || !sink->showStoredPage(1)) return false;
+  screenOwned_ = true;
+  scheduleLocalPage();
+  return true;
+}
+
+#endif  // SIDECAR_LINK
diff --git a/src/SidecarSink.h b/src/SidecarSink.h
new file mode 100644
index 00000000..8a4ec4a2
--- /dev/null
+++ b/src/SidecarSink.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+// DESIGN INTENT: Sidecar display implementations expose one-frame drawing plus recoverable
+// multi-page storage/navigation without requiring callers to know panel or storage details.
+// DONE-WHEN: v1 drawing remains valid and page bundles can stage, commit, abandon, and navigate.
+// FAILS-WHEN: callers can publish an incomplete bundle or must allocate a second full framebuffer.
+
+// Abstract display sink for the Eink Sidecar.
+// Rotation is the sink's problem, not the caller's: callers pass a line index
+// and a UTF-8 string, and the implementation maps that to the panel's current
+// orientation (portrait, landscape, mirrored, etc.).
+class SidecarSink {
+ public:
+  static constexpr uint8_t kMaxStoredPages = 16;
+  static constexpr uint8_t kMaxGroupPages = 4;
+  virtual ~SidecarSink() = default;
+
+  // Prepare a blank frame. Nothing reaches the panel until present().
+  // Callers must invoke beginFrame() before any drawCenteredLine() calls;
+  // drawing before beginFrame() is undefined-but-safe.
+  virtual void beginFrame() = 0;
+
+  // Draw one line of UTF-8 text, horizontally centred, at line index `line`
+  // (0 = first line from the top). Line spacing is the sink's business.
+  // If `line` is >= maxLines(), the implementation clips. If `text` is nullptr
+  // or empty, the implementation treats it as a blank line.
+  virtual void drawCenteredLine(int line, const char* text) = 0;
+
+  // Blit a 1-bit-per-pixel image into the frame at (x, y). Nothing reaches the panel until
+  // present(). `data` is MSB-first, rows padded to whole bytes: each row occupies
+  // ((w + 7) / 8) bytes and rows are contiguous. `data` must hold h of those rows.
+  //
+  // Coordinates and `data` are in the sink's own logical space, the same space width() and
+  // height() describe. Callers never rotate; that is the sink's business (D-039).
+  //
+  // Returns false and draws NOTHING if data is null, w or h is 0, or the rectangle would fall
+  // outside width() x height(). Partial blits are never performed - a caller that gets false
+  // knows the frame is unchanged.
+  virtual bool blit1bpp(uint16_t x, uint16_t y, uint16_t w, uint16_t h, const uint8_t* data) = 0;
+
+  // Submit the framebuffer and block until the panel driver's refresh wait returns. The X3
+  // driver exposes no hardware-success status beyond that completed call.
+  virtual void present() = 0;
+
+  // Protocol v2/v3 page bundles. V2 contains exactly two full-panel frames; v3 may contain
+  // between one and kMaxStoredPages frames.
+  // beginPageBundle selects the inactive on-disk bank, storePage persists the framebuffer
+  // currently owned by the sink, and commitPageBundle publishes the bank only after both pages
+  // have arrived and passed their transport checksum. The previous bundle remains readable after
+  // any interrupted transfer. These methods never allocate another full framebuffer in RAM.
+  virtual bool beginPageBundle(uint8_t pageCount, uint8_t activePage) = 0;
+  virtual bool storePage(uint8_t pageIndex, uint32_t crc32) = 0;
+  virtual bool commitPageBundle() = 0;
+  virtual void abandonPageBundle() = 0;
+
+  // Protocol v4 atomic group replacement. Implementations return false until their storage
+  // format can keep the prior group readable through an interrupted update.
+  // activePage is transaction metadata validated for consistency by the parser. A grouped
+  // background refresh preserves the device's current durable selection while replacing content.
+  virtual bool beginPageGroup(uint8_t catalogPageCount, uint8_t activePage,
+                              uint8_t groupStart, uint8_t groupPageCount) { return false; }
+
+  // Show the previous (-1), current (0), or next (+1) stored page. Returns false when no valid
+  // stored bundle exists. A one-page bundle accepts restore/current operations; previous/next wrap
+  // to that same page. Implementations persist a changed selection so navigation survives
+  // deep sleep; showing the current page is used to restore visible content after a hard reset.
+  virtual bool showStoredPage(int8_t delta) = 0;
+  virtual bool hasStoredPages() = 0;
+  // Optional staged handoff: existing implementations keep immediate commit behavior.
+  virtual void deferBundleUntilCycle(bool enabled) {}
+  virtual bool hasPendingBundle() const { return false; }
+  virtual bool activatePendingBundle() { return false; }
+  virtual bool backgroundReceptionSafe() const { return false; }
+  virtual bool atLastStoredPage() const { return false; }
+
+  // Geometry in the sink's own logical coordinate space.
+  virtual uint16_t width() const = 0;
+  virtual uint16_t height() const = 0;
+
+  // Bytes per row for a full-width 1bpp image in this sink's logical space: (width() + 7) / 8.
+  // The framing layer sizes its single row buffer from this and never allocates per frame.
+  virtual uint16_t rowBytes() const = 0;
+
+  // How many lines drawCenteredLine() can fit before running off the panel.
+  virtual int maxLines() const = 0;
+};
+
+// Defined by exactly one platform translation unit.
+// Returns nullptr if the display is not ready. Callers MUST null-check.
+SidecarSink* sidecarSinkInstance();
diff --git a/src/SidecarSinkX3.cpp b/src/SidecarSinkX3.cpp
new file mode 100644
index 00000000..84155fbc
--- /dev/null
+++ b/src/SidecarSinkX3.cpp
@@ -0,0 +1,688 @@
+#include "SidecarSink.h"
+
+#ifndef SIDECAR_LINK
+SidecarSink* sidecarSinkInstance() { return nullptr; }
+#else
+
+#include <GfxRenderer.h>
+#include <HalDisplay.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#include "SidecarCollectionsV5Store.h"
+#include "fontIds.h"
+
+extern HalDisplay display;
+extern GfxRenderer renderer;
+
+namespace {
+// DESIGN INTENT:
+// DONE-WHEN: v2/v3 stage checked full-screen bundles and v4 atomically replaces a small contiguous
+// group while preserving the other pages; completed banks reload by button after sleep; v1 presents.
+// INPUTS: 1..16 pages, valid group ranges, any valid active page, interrupted writes,
+// corrupt/short files, storage exhaustion, and v1.
+// FAILS-WHEN: an incomplete bundle replaces the valid one, a bad page displays, or RAM holds 2 frames.
+constexpr int kFontId = NOTOSANS_18_FONT_ID;
+constexpr int kTopMargin = 10;
+constexpr int kSideMargin = 8;
+constexpr size_t kLegacyManifestSize = 28;
+constexpr size_t kManifestSize = 16 + 4 * SidecarSink::kMaxStoredPages + 4;
+constexpr char kManifest0[] = "/.crosspoint/sidecar_pages_0.manifest";
+constexpr char kManifest1[] = "/.crosspoint/sidecar_pages_1.manifest";
+constexpr char kSelection[] = "/.crosspoint/sidecar_pages.selection";
+
+struct Manifest {
+  uint8_t bank = 0, count = 0, active = 0;
+  uint16_t width = 0, height = 0;
+  uint32_t generation = 0;
+  uint32_t crc[SidecarSink::kMaxStoredPages] = {};
+};
+
+uint32_t crc32Update(uint32_t crc, const uint8_t* data, size_t len) {
+  crc = ~crc;
+  for (size_t i = 0; i < len; ++i) {
+    crc ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+  }
+  return ~crc;
+}
+uint32_t crc32RawUpdate(uint32_t raw, const uint8_t* data, size_t len) {
+  for (size_t i = 0; i < len; ++i) {
+    raw ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit) raw = (raw >> 1) ^ (0xEDB88320u & (0u - (raw & 1u)));
+  }
+  return raw;
+}
+void put16(uint8_t* p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
+void put32(uint8_t* p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+uint16_t get16(const uint8_t* p) { return p[0] | (static_cast<uint16_t>(p[1]) << 8); }
+uint32_t get32(const uint8_t* p) {
+  return p[0] | (static_cast<uint32_t>(p[1]) << 8) | (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+const char* manifestPath(uint8_t bank) { return bank ? kManifest1 : kManifest0; }
+void pagePath(uint8_t bank, uint8_t page, char* out, size_t size) {
+  std::snprintf(out, size, "/.crosspoint/sidecar_pages_%u_%u.bin", bank, page);
+}
+int computeMaxLines(int h, int lineHeight) {
+  return lineHeight > 0 && h > kTopMargin ? (h - kTopMargin) / lineHeight : 0;
+}
+
+class SidecarSinkX3 : public SidecarSink {
+ public:
+  SidecarSinkX3(HalDisplay& d, GfxRenderer& r)
+      : display_(d), renderer_(r), savedOrientation_(GfxRenderer::Orientation::Portrait) {}
+
+  void beginFrame() override {
+    if (stagingActive_) {
+      if (stagingFile_) stagingFile_.close();
+      stagingBytes_ = 0;
+      char path[64]; pagePath(staging_.bank, stagingNext_, path, sizeof(path));
+      stagingFileOk_ = Storage.openFileForWrite("SIDECAR", path, stagingFile_);
+      return; // Incoming bundle rows never touch the displayed framebuffer.
+    }
+    if (!orientationSaved_) { savedOrientation_ = renderer_.getOrientation(); orientationSaved_ = true; }
+    renderer_.setOrientation(GfxRenderer::Orientation::Portrait);
+    display_.clearScreen(0xFF);
+    if (!geometryLogged_) {
+      char b[128];
+      std::snprintf(b, sizeof(b), "geometry logical w=%d h=%d lineHeight=%d maxLines=%d prevOrientation=%d",
+                    renderer_.getScreenWidth(), renderer_.getScreenHeight(), renderer_.getLineHeight(kFontId),
+                    maxLines(), static_cast<int>(savedOrientation_));
+      LOG_INF("SINK", "%s", b); geometryLogged_ = true;
+    }
+  }
+
+  void drawCenteredLine(int line, const char* text) override {
+    if (line < 0 || line >= maxLines()) return;
+    const int lh = renderer_.getLineHeight(kFontId);
+    if (lh <= 0) return;
+    if (!text || !text[0]) {
+      renderer_.drawCenteredText(kFontId, kTopMargin + line * lh, " ", true);
+      return;
+    }
+    const auto rows = renderer_.wrappedText(kFontId, text, static_cast<int>(width()) - 2 * kSideMargin,
+                                            maxLines() - line);
+    for (const auto& row : rows) {
+      if (line >= maxLines()) break;
+      renderer_.drawCenteredText(kFontId, kTopMargin + line++ * lh, row.c_str(), true);
+    }
+  }
+
+  bool blit1bpp(uint16_t x, uint16_t y, uint16_t w, uint16_t h, const uint8_t* data) override {
+    if (!data || !w || !h || static_cast<uint32_t>(x) + w > width() ||
+        static_cast<uint32_t>(y) + h > height()) return false;
+    if (stagingActive_) {
+      const size_t bytes = static_cast<size_t>(rowBytes()) * h;
+      if (!stagingFileOk_ || x != 0 || w != width() ||
+          static_cast<size_t>(y) * rowBytes() != stagingBytes_) return false;
+      if (stagingFile_.write(data, bytes) != bytes) { stagingFileOk_ = false; return false; }
+      stagingBytes_ += bytes;
+      return true;
+    }
+    display_.drawImage(data, x, y, w, h);
+    if (!blitLoggedOnce_) {
+      LOG_INF("SINK", "blit x=%u y=%u w=%u h=%u logicalW=%u logicalH=%u panelW=%u panelH=%u",
+              x, y, w, h, width(), height(), display_.getDisplayWidth(), display_.getDisplayHeight());
+      blitLoggedOnce_ = true;
+    }
+    return true;
+  }
+
+  void present() override {
+    display_.displayBuffer(HalDisplay::FAST_REFRESH);
+    display_.waitRefreshComplete();
+    restoreOrientation();
+  }
+
+  bool beginPageBundle(uint8_t count, uint8_t active) override {
+    if (count == 0 || count > kMaxStoredPages || active >= count) return false;
+    if (ready_) return false;  // A verified deferred catalog owns the inactive bank until activation.
+    deferCommit_ = deferNextBundle_;
+    deferNextBundle_ = false;
+    ready_ = false;
+    Manifest current;
+    // This runs while the phone is streaming writes. Validate only the small manifest records
+    // here; full page-file CRC checks remain mandatory at commit and before display.
+    const bool haveCurrent = activeCacheValid_ ? (current = activeCache_, true) : loadNewestManifest(current);
+    if (haveCurrent && !activeCacheValid_) {
+      applySelection(current);
+      activeCache_ = current;
+      activeCacheValid_ = true;
+    }
+    staging_ = Manifest{};
+    staging_.bank = haveCurrent ? static_cast<uint8_t>(current.bank ^ 1u) : 0;
+    staging_.count = count; staging_.active = active; staging_.width = width(); staging_.height = height();
+    if (deferCommit_ && haveCurrent) {
+      // Preserve the durable local selection. If the replacement shrinks the catalog, clamp to
+      // its last valid page instead of jumping to the phone's stale selection snapshot.
+      staging_.active = current.active < count ? current.active : static_cast<uint8_t>(count - 1u);
+    }
+    staging_.generation = haveCurrent ? current.generation + 1u : 1u;
+    if (!clearInactiveBank(staging_.bank)) {
+      LOG_ERR("SIDECAR", "bundle stage: failed to reclaim inactive bank=%u", staging_.bank);
+      return false;
+    }
+    stagingNext_ = 0; stagingEnd_ = count; stagingActive_ = true;
+    LOG_INF("SIDECAR", "bundle stage bank=%u generation=%lu pages=%u active=%u", staging_.bank,
+            static_cast<unsigned long>(staging_.generation), count, active);
+    return true;
+  }
+
+  bool beginPageGroup(uint8_t catalogCount, uint8_t active, uint8_t groupStart,
+                      uint8_t groupCount) override {
+    if (catalogCount == 0 || catalogCount > kMaxStoredPages || active >= catalogCount ||
+        groupCount == 0 || groupCount > kMaxGroupPages || groupStart >= catalogCount ||
+        static_cast<uint16_t>(groupStart) + groupCount > catalogCount) return false;
+    if (ready_) return false;  // Do not overwrite a verified group waiting at the cycle boundary.
+    Manifest current;
+    const bool haveCurrent = activeCacheValid_ ? (current = activeCache_, true)
+                                                : loadNewestManifest(current);
+    if (!haveCurrent || current.count != catalogCount) return false;
+    applySelection(current);
+    activeCache_ = current;
+    activeCacheValid_ = true;
+    deferCommit_ = deferNextBundle_;
+    deferNextBundle_ = false;
+    staging_ = current;
+    staging_.bank = static_cast<uint8_t>(current.bank ^ 1u);
+    // Preserve the X3's current position while content behind it is replaced.
+    staging_.active = current.active;
+    staging_.generation = current.generation + 1u;
+    if (!clearInactiveBank(staging_.bank)) {
+      LOG_ERR("SIDECAR", "group stage: failed to reclaim inactive bank=%u", staging_.bank);
+      return false;
+    }
+    stagingNext_ = groupStart;
+    stagingEnd_ = static_cast<uint8_t>(groupStart + groupCount);
+    stagingActive_ = true;
+    ready_ = false;
+
+    // Populate the inactive bank with the unchanged pages before accepting replacement bytes.
+    // If power or storage fails here the current manifest still points exclusively at the old bank.
+    for (uint8_t page = 0; page < catalogCount; ++page) {
+      if (page >= groupStart && page < stagingEnd_) continue;
+      char source[64], destination[64];
+      pagePath(current.bank, page, source, sizeof(source));
+      pagePath(staging_.bank, page, destination, sizeof(destination));
+      if (!copyPageFile(source, destination, current.crc[page])) {
+        abandonPageBundle();
+        LOG_ERR("SIDECAR", "%s", "group stage: unchanged page copy failed");
+        return false;
+      }
+    }
+    LOG_INF("SIDECAR", "group stage bank=%u generation=%lu range=%u..%u catalog=%u",
+            staging_.bank, static_cast<unsigned long>(staging_.generation), groupStart,
+            static_cast<unsigned>(stagingEnd_ - 1u), catalogCount);
+    return true;
+  }
+
+  bool storePage(uint8_t page, uint32_t expectedCrc) override {
+    if (!stagingActive_ || page != stagingNext_ || page >= stagingEnd_) return false;
+    const size_t size = display_.getBufferSize();
+    const size_t written = stagingBytes_;
+    if (stagingFile_) { stagingFile_.flush(); stagingFile_.close(); }
+    if (!stagingFileOk_ || written != size) return false;
+    char path[64]; pagePath(staging_.bank, page, path, sizeof(path));
+    if (!verifyPageFile(path, expectedCrc)) return false;
+    staging_.crc[page] = expectedCrc; ++stagingNext_;
+    LOG_INF("SIDECAR", "bundle page stored bank=%u page=%u bytes=%u", staging_.bank, page,
+            static_cast<unsigned>(written));
+    return true;
+  }
+
+  bool commitPageBundle() override {
+    if (!stagingActive_ || stagingNext_ != stagingEnd_) return false;
+    if (deferCommit_ && activeCacheValid_ && activeCache_.count >= 1) {
+      ready_ = true;
+      LOG_INF("SIDECAR", "bundle ready generation=%lu; waiting for cycle boundary",
+              static_cast<unsigned long>(staging_.generation));
+      return true;
+    }
+    Manifest previous;
+    const bool havePrevious = loadNewestManifest(previous);
+    if (havePrevious) applySelection(previous);
+    Manifest committed = staging_;
+    if (!loadPage(committed, committed.active)) {
+      if (havePrevious && !loadPage(previous, previous.active)) {
+        activeCacheValid_ = false;
+        LOG_ERR("SIDECAR", "%s", "bundle load and rollback both failed; suppressing presentation");
+      }
+      return false;
+    }
+    if (!writeSelection(committed) || !writeManifest(committed)) {
+      // writeManifest() verifies after closing the file. A storage layer may report a failed
+      // write/verification after a complete, valid newer manifest reached the media. Remove the
+      // candidate manifest before reloading so failed publication can never supersede `previous`.
+      if (Storage.exists(manifestPath(committed.bank)) &&
+          !Storage.remove(manifestPath(committed.bank))) {
+        LOG_ERR("SIDECAR", "%s", "failed candidate manifest could not be removed");
+        activeCacheValid_ = false;
+        return false;
+      }
+      if (havePrevious && !loadPage(previous, previous.active)) {
+        activeCacheValid_ = false;
+        LOG_ERR("SIDECAR", "%s", "bundle publish rollback failed; suppressing presentation");
+      }
+      return false;
+    }
+    activeCache_ = committed;
+    activeCacheValid_ = true;
+    stagingActive_ = false; stagingNext_ = 0; stagingEnd_ = 0; ready_ = false; deferCommit_ = false;
+    present();
+    LOG_INF("SIDECAR", "bundle committed bank=%u generation=%lu active=%u/%u", committed.bank,
+            static_cast<unsigned long>(committed.generation), committed.active + 1, committed.count);
+    return true;
+  }
+
+  void deferBundleUntilCycle(bool enabled) override { deferNextBundle_ = enabled; }
+  bool hasPendingBundle() const override { return ready_; }
+  bool backgroundReceptionSafe() const override { return deferCommit_ && stagingActive_; }
+  bool atLastStoredPage() const override {
+    bool v5Last = false;
+    if (v5PositionIsLast(v5Last)) return v5Last;
+    return activeCacheValid_ && activeCache_.active + 1 == activeCache_.count;
+  }
+  bool activatePendingBundle() override {
+    if (!ready_) return false;
+    // Local turns may continue after staging completes. Carry the latest durable selection into
+    // the pending bank at the handoff boundary instead of presenting the begin-time snapshot.
+    if (activeCacheValid_) {
+      staging_.active = activeCache_.active < staging_.count
+          ? activeCache_.active
+          : static_cast<uint8_t>(staging_.count - 1u);
+    }
+    deferCommit_ = false;
+    return commitPageBundle();
+  }
+
+  void abandonPageBundle() override {
+    // A fully verified deferred catalog is no longer an in-progress parser transaction. Preserve
+    // it across disconnects, overflow recovery, or stray packets until the cycle boundary can
+    // activate it. It has not been acknowledged to the phone and the old manifest remains live.
+    if (ready_) {
+      if (stagingFile_) stagingFile_.close();
+      stagingFileOk_ = false;
+      return;
+    }
+    if (stagingFile_) stagingFile_.close(); stagingFileOk_ = false; ready_ = false;
+    deferCommit_ = false; deferNextBundle_ = false;
+    stagingActive_ = false; stagingNext_ = 0; stagingEnd_ = 0;
+    // A rejected transfer may have partially overwritten the live framebuffer. Reload the last
+    // committed selection without refreshing so any later unrelated present cannot expose it.
+    Manifest previous;
+    if (loadNewestManifest(previous)) {
+      applySelection(previous);
+      if (loadPage(previous, previous.active)) {
+        activeCache_ = previous;
+        activeCacheValid_ = true;
+      }
+    }
+  }
+
+  bool showStoredPage(int8_t delta) override {
+    if (delta < -1 || delta > 1) return false;
+    if (showV5StoredPage(delta)) return true;
+    Manifest m;
+    if (activeCacheValid_) {
+      m = activeCache_;
+    } else {
+      if (!loadNewestManifest(m) || m.count == 0) return false;
+      applySelection(m);
+      activeCache_ = m;
+      activeCacheValid_ = true;
+    }
+    if (m.count == 0) return false;
+    const uint8_t previous = m.active;
+    const uint8_t next = static_cast<uint8_t>((m.active + delta + m.count) % m.count);
+    if (!loadPage(m, next)) {
+      if (!loadPage(m, previous)) {
+        activeCacheValid_ = false;
+        LOG_ERR("SIDECAR", "%s", "page load and rollback both failed; suppressing presentation");
+      }
+      return false;
+    }
+    m.active = next;
+    if (delta != 0 && !writeSelection(m)) {
+      // Selection did not become durable. Restore the prior page in RAM so a later unrelated
+      // refresh cannot expose the uncommitted navigation target.
+      if (!loadPage(m, previous)) {
+        activeCacheValid_ = false;
+        LOG_ERR("SIDECAR", "%s", "selection rollback failed; suppressing presentation");
+      }
+      return false;
+    }
+    activeCache_ = m;
+    present();
+    LOG_INF("SIDECAR", "bundle page shown %u/%u", m.active + 1, m.count);
+    return true;
+  }
+
+  bool hasStoredPages() override {
+    if (hasV5StoredPages()) return true;
+    Manifest m;
+    if (!loadNewestManifest(m) || m.count == 0) return false;
+    applySelection(m);
+    activeCache_ = m;
+    activeCacheValid_ = true;
+    return true;
+  }
+  uint16_t width() const override { return display_.getDisplayWidth(); }
+  uint16_t height() const override { return display_.getDisplayHeight(); }
+  uint16_t rowBytes() const override { return (width() + 7) / 8; }
+  int maxLines() const override { return computeMaxLines(renderer_.getScreenHeight(), renderer_.getLineHeight(kFontId)); }
+
+ private:
+  bool loadV5Page(const sidecar::v5::CollectionManifest& manifest, uint8_t page) {
+    if (page >= manifest.pageCount || manifest.width != width() || manifest.height != height()) return false;
+    char path[80];
+    if (!sidecar::v5::Store::pagePath(manifest.collectionId, manifest.bank, page, path, sizeof(path)))
+      return false;
+    HalFile file;
+    if (!Storage.openFileForRead("SCV5", path, file)) return false;
+    uint8_t* frame = display_.getFrameBuffer(); const size_t size = display_.getBufferSize();
+    if (!frame || !size || file.size() != size) { file.close(); return false; }
+    size_t offset = 0; uint32_t rawCrc = 0xFFFFFFFFu;
+    while (offset < size) {
+      const size_t wanted = (size - offset) < sizeof(verifyChunk_) ? (size - offset) : sizeof(verifyChunk_);
+      const size_t n = file.read(frame + offset, wanted);
+      if (n != wanted) { file.close(); return false; }
+      rawCrc = crc32RawUpdate(rawCrc, frame + offset, n); offset += n;
+    }
+    file.close();
+    return (rawCrc ^ 0xFFFFFFFFu) == manifest.pageCrc[page];
+  }
+
+  bool loadV5Catalog(sidecar::v5::RootIndex& root, sidecar::v5::Selection& selection,
+                     bool& selectionValid, uint16_t& totalPages, uint16_t& selectedOrdinal) const {
+    sidecar::v5::Store store;
+    if (!store.loadNewestRoot(root) || root.entryCount == 0) return false;
+    selectionValid = store.loadSelection(selection) && selection.rootGeneration == root.generation;
+    totalPages = 0; selectedOrdinal = 0;
+    bool foundSelection = false;
+    for (uint8_t i = 0; i < root.entryCount; ++i) {
+      const auto& entry = root.entries[i];
+      if (!(entry.flags & sidecar::v5::kEnabled)) continue;
+      sidecar::v5::CollectionManifest manifest{};
+      if (!store.loadCollectionManifest(entry.collectionId, entry.expectedGeneration, manifest) ||
+          manifest.pageCount == 0 || manifest.width != width() || manifest.height != height()) return false;
+      if (selectionValid && selection.collectionId == entry.collectionId &&
+          selection.collectionGeneration == manifest.generation && selection.pageIndex < manifest.pageCount) {
+        selectedOrdinal = static_cast<uint16_t>(totalPages + selection.pageIndex);
+        foundSelection = true;
+      }
+      totalPages = static_cast<uint16_t>(totalPages + manifest.pageCount);
+    }
+    selectionValid = selectionValid && foundSelection;
+    return totalPages > 0;
+  }
+
+  bool locateV5Page(const sidecar::v5::RootIndex& root, uint16_t ordinal,
+                    sidecar::v5::CollectionManifest& manifest, uint8_t& page) const {
+    sidecar::v5::Store store; uint16_t base = 0;
+    for (uint8_t i = 0; i < root.entryCount; ++i) {
+      const auto& entry = root.entries[i];
+      if (!(entry.flags & sidecar::v5::kEnabled)) continue;
+      sidecar::v5::CollectionManifest candidate{};
+      if (!store.loadCollectionManifest(entry.collectionId, entry.expectedGeneration, candidate)) return false;
+      if (ordinal < base + candidate.pageCount) {
+        manifest = candidate; page = static_cast<uint8_t>(ordinal - base); return true;
+      }
+      base = static_cast<uint16_t>(base + candidate.pageCount);
+    }
+    return false;
+  }
+
+  bool showV5StoredPage(int8_t delta) {
+    sidecar::v5::RootIndex root{}; sidecar::v5::Selection selection{};
+    bool selectionValid = false; uint16_t total = 0, current = 0;
+    if (!loadV5Catalog(root, selection, selectionValid, total, current)) return false;
+    if (!selectionValid) current = 0;
+    const uint16_t next = static_cast<uint16_t>((static_cast<int32_t>(current) + delta + total) % total);
+    sidecar::v5::CollectionManifest manifest{}; uint8_t page = 0;
+    if (!locateV5Page(root, next, manifest, page) || !loadV5Page(manifest, page)) {
+      LOG_ERR("SIDECAR", "v5 page load failed ordinal=%u total=%u", next, total); return false;
+    }
+    sidecar::v5::Selection updated{};
+    updated.rotationMode = selectionValid ? selection.rotationMode : sidecar::v5::RotationMode::Automatic;
+    updated.rootGeneration = root.generation; updated.collectionId = manifest.collectionId;
+    updated.collectionGeneration = manifest.generation; updated.pageIndex = page;
+    if ((!selectionValid || delta != 0) && !sidecar::v5::Store().writeSelectionVerified(updated)) {
+      LOG_ERR("SIDECAR", "%s", "v5 selection persistence failed"); return false;
+    }
+    present();
+    LOG_INF("SIDECAR", "v5 page shown collection=%lu generation=%lu page=%u/%u ordinal=%u/%u",
+            static_cast<unsigned long>(manifest.collectionId), static_cast<unsigned long>(manifest.generation),
+            static_cast<unsigned>(page + 1u), static_cast<unsigned>(manifest.pageCount),
+            static_cast<unsigned>(next + 1u), static_cast<unsigned>(total));
+    return true;
+  }
+
+  bool hasV5StoredPages() const {
+    sidecar::v5::RootIndex root{}; sidecar::v5::Selection selection{};
+    bool valid = false; uint16_t total = 0, selected = 0;
+    return loadV5Catalog(root, selection, valid, total, selected);
+  }
+
+  bool v5PositionIsLast(bool& last) const {
+    sidecar::v5::RootIndex root{}; sidecar::v5::Selection selection{};
+    bool valid = false; uint16_t total = 0, selected = 0;
+    if (!loadV5Catalog(root, selection, valid, total, selected)) return false;
+    last = valid && selected + 1u == total; return true;
+  }
+
+  bool removeScratchFile(const char* path) {
+    if (!Storage.exists(path)) return true;
+    // SdFat can report a failed remove while its directory update has already reached the card.
+    // Judge the durable postcondition, and retry transient failures before rejecting the bundle.
+    for (uint8_t attempt = 0; attempt < 3; ++attempt) {
+      Storage.remove(path);
+      if (!Storage.exists(path)) return true;
+      delay(5);
+    }
+    // Some damaged/stale FAT directory entries refuse unlink but still permit O_TRUNC. A zero-byte
+    // inactive object holds no page clusters and is safe scratch: replacement pages overwrite it,
+    // while an unused page or manifest remains invalid and cannot be published.
+    HalFile truncated;
+    if (Storage.openFileForWrite("SIDECAR", path, truncated)) {
+      truncated.flush();
+      truncated.close();
+      HalFile check;
+      if (Storage.openFileForRead("SIDECAR", path, check)) {
+        const bool empty = check.size() == 0;
+        check.close();
+        if (empty) {
+          LOG_INF("SIDECAR", "inactive-bank file truncated path=%s", path);
+          return true;
+        }
+      }
+    }
+    // Last-resort recovery for a damaged long-file-name entry: move the orphan out of the
+    // canonical page namespace. The remaining inactive files can then be reclaimed and this page
+    // can be recreated. One orphan framebuffer costs far less than retaining an entire stale bank.
+    for (uint8_t slot = 0; slot < kMaxStoredPages; ++slot) {
+      char orphan[64];
+      std::snprintf(orphan, sizeof(orphan), "/.crosspoint/sidecar_orphan_%u.bin", slot);
+      if (Storage.exists(orphan)) continue;
+      if (Storage.rename(path, orphan) && !Storage.exists(path)) {
+        LOG_INF("SIDECAR", "inactive-bank file quarantined path=%s as=%s", path, orphan);
+        return true;
+      }
+    }
+    LOG_ERR("SIDECAR", "inactive-bank remove failed path=%s", path);
+    return false;
+  }
+
+  bool clearInactiveBank(uint8_t bank) {
+    // The inactive bank is unpublished scratch space. Remove its stale manifest first so a power
+    // loss during reclamation can only leave the current published bank eligible for restoration.
+    const char* manifest = manifestPath(bank);
+    if (!removeScratchFile(manifest)) return false;
+    for (uint8_t page = 0; page < kMaxStoredPages; ++page) {
+      char path[64];
+      pagePath(bank, page, path, sizeof(path));
+      if (!removeScratchFile(path)) return false;
+    }
+    return true;
+  }
+
+  void restoreOrientation() {
+    if (orientationSaved_) { renderer_.setOrientation(savedOrientation_); orientationSaved_ = false; }
+  }
+
+  bool readManifest(uint8_t bank, Manifest& out, bool verifyPages = true) {
+    HalFile f;
+    if (!Storage.openFileForRead("SIDECAR", manifestPath(bank), f)) return false;
+    const size_t size = f.size();
+    uint8_t b[kManifestSize] = {};
+    if (size != kLegacyManifestSize && size != kManifestSize) { f.close(); return false; }
+    const size_t n = f.read(b, size); f.close();
+    if (n != size) return false;
+    out = Manifest{};
+    if (size == kLegacyManifestSize) {
+      if (std::memcmp(b, "SPG2", 4) || b[4] != 1 || b[5] != bank ||
+          crc32Update(0, b, 24) != get32(b + 24)) return false;
+      if (b[6] != 2) return false;  // SPG2 contains CRC fields for exactly two pages.
+      out.crc[0] = get32(b + 16); out.crc[1] = get32(b + 20);
+    } else {
+      if (std::memcmp(b, "SPG3", 4) || b[4] != 1 || b[5] != bank ||
+          crc32Update(0, b, kManifestSize - 4) != get32(b + kManifestSize - 4)) return false;
+      for (uint8_t page = 0; page < kMaxStoredPages; ++page) out.crc[page] = get32(b + 16 + page * 4);
+    }
+    out.bank = b[5]; out.count = b[6]; out.active = b[7]; out.width = get16(b + 8); out.height = get16(b + 10);
+    out.generation = get32(b + 12);
+    if (out.count == 0 || out.count > kMaxStoredPages || out.active >= out.count ||
+        out.width != width() || out.height != height()) return false;
+    if (verifyPages) {
+      for (uint8_t page = 0; page < out.count; ++page) {
+        char path[64]; pagePath(out.bank, page, path, sizeof(path));
+        if (!verifyPageFile(path, out.crc[page])) return false;
+      }
+    }
+    return true;
+  }
+
+  bool loadNewestManifest(Manifest& out, bool verifyPages = true) {
+    Manifest a, b; const bool ha = readManifest(0, a, verifyPages), hb = readManifest(1, b, verifyPages);
+    if (!ha && !hb) return false;
+    const bool aIsNewer = ha && (!hb || static_cast<int32_t>(a.generation - b.generation) >= 0);
+    out = aIsNewer ? a : b; return true;
+  }
+
+  bool writeManifest(const Manifest& m) {
+    uint8_t b[kManifestSize] = {}; std::memcpy(b, "SPG3", 4); b[4] = 1; b[5] = m.bank; b[6] = m.count; b[7] = m.active;
+    put16(b + 8, m.width); put16(b + 10, m.height); put32(b + 12, m.generation);
+    for (uint8_t page = 0; page < kMaxStoredPages; ++page) put32(b + 16 + page * 4, m.crc[page]);
+    put32(b + kManifestSize - 4, crc32Update(0, b, kManifestSize - 4));
+    HalFile f; if (!Storage.openFileForWrite("SIDECAR", manifestPath(m.bank), f)) return false;
+    const size_t written = f.write(b, sizeof(b)); f.flush(); f.close();
+    if (written != sizeof(b)) return false;
+    Manifest verified;
+    if (!readManifest(m.bank, verified) || verified.bank != m.bank || verified.count != m.count ||
+        verified.active != m.active || verified.generation != m.generation) return false;
+    for (uint8_t page = 0; page < m.count; ++page) if (verified.crc[page] != m.crc[page]) return false;
+    return true;
+  }
+
+  bool loadPage(const Manifest& m, uint8_t page) {
+    if (page >= m.count) return false;
+    char path[64]; pagePath(m.bank, page, path, sizeof(path));
+    HalFile f;
+    if (!Storage.openFileForRead("SIDECAR", path, f)) return false;
+    uint8_t* frame = display_.getFrameBuffer(); const size_t size = display_.getBufferSize();
+    if (!frame || !size || f.size() != size) { f.close(); return false; }
+    size_t offset = 0;
+    uint32_t rawCrc = 0xFFFFFFFFu;
+    while (offset < size) {
+      const size_t wanted = (size - offset) < sizeof(verifyChunk_) ? (size - offset) : sizeof(verifyChunk_);
+      const size_t n = f.read(frame + offset, wanted);
+      if (n != wanted) { f.close(); return false; }
+      rawCrc = crc32RawUpdate(rawCrc, frame + offset, n);
+      offset += n;
+    }
+    f.close();
+    return (rawCrc ^ 0xFFFFFFFFu) == m.crc[page];
+  }
+
+  bool verifyPageFile(const char* path, uint32_t expectedCrc) {
+    HalFile f;
+    if (!Storage.openFileForRead("SIDECAR", path, f) || f.size() != display_.getBufferSize()) {
+      if (f) f.close();
+      return false;
+    }
+    // SD command overhead dominates with 256-byte reads. A fixed 2 KiB member buffer keeps
+    // verification bounded while reducing a full X3 page from 205 reads to 26.
+    uint8_t* chunk = verifyChunk_;
+    size_t remaining = display_.getBufferSize();
+    uint32_t rawCrc = 0xFFFFFFFFu;
+    while (remaining > 0) {
+      const size_t wanted = remaining < sizeof(verifyChunk_) ? remaining : sizeof(verifyChunk_);
+      const size_t n = f.read(chunk, wanted);
+      if (n != wanted) { f.close(); return false; }
+      rawCrc = crc32RawUpdate(rawCrc, chunk, n);
+      remaining -= n;
+    }
+    f.close();
+    return (rawCrc ^ 0xFFFFFFFFu) == expectedCrc;
+  }
+
+  bool copyPageFile(const char* source, const char* destination, uint32_t expectedCrc) {
+    HalFile in, out;
+    if (!Storage.openFileForRead("SIDECAR", source, in) || in.size() != display_.getBufferSize()) {
+      if (in) in.close();
+      return false;
+    }
+    if (!Storage.openFileForWrite("SIDECAR", destination, out)) { in.close(); return false; }
+    size_t remaining = display_.getBufferSize();
+    bool ok = true;
+    while (remaining > 0) {
+      const size_t wanted = remaining < sizeof(verifyChunk_) ? remaining : sizeof(verifyChunk_);
+      const size_t read = in.read(verifyChunk_, wanted);
+      if (read != wanted || out.write(verifyChunk_, read) != read) { ok = false; break; }
+      remaining -= read;
+    }
+    in.close(); out.flush(); out.close();
+    // verifyPageFile reopens the closed destination, requires the exact persisted framebuffer
+    // length, reads every byte, and recomputes CRC before this clone can become publishable.
+    return ok && remaining == 0 && verifyPageFile(destination, expectedCrc);
+  }
+
+  bool writeSelection(const Manifest& m) {
+    uint8_t b[12] = {'S','P','S','1',m.bank,m.active,0,0,0,0,0,0};
+    put32(b + 6, m.generation); put16(b + 10, static_cast<uint16_t>(crc32Update(0, b, 10)));
+    // The selection is advisory until its matching manifest is published. Reclaim or quarantine
+    // a damaged old directory entry before replacing it; the old manifest still carries a safe
+    // active-page fallback if power fails in this interval.
+    if (!removeScratchFile(kSelection)) return false;
+    HalFile f; if (!Storage.openFileForWrite("SIDECAR", kSelection, f)) return false;
+    const size_t written = f.write(b, sizeof(b)); f.flush(); f.close();
+    if (written != sizeof(b)) return false;
+    HalFile check; if (!Storage.openFileForRead("SIDECAR", kSelection, check)) return false;
+    uint8_t readback[sizeof(b)];
+    const size_t n = check.read(readback, sizeof(readback)); const size_t size = check.size(); check.close();
+    return n == sizeof(readback) && size == sizeof(readback) && !std::memcmp(b, readback, sizeof(b));
+  }
+
+  void applySelection(Manifest& m) {
+    HalFile f; if (!Storage.openFileForRead("SIDECAR", kSelection, f)) return;
+    uint8_t b[12]; const size_t n = f.read(b, sizeof(b)); f.close();
+    if (n == sizeof(b) && !std::memcmp(b, "SPS1", 4) && get16(b + 10) == static_cast<uint16_t>(crc32Update(0, b, 10)) &&
+        b[4] == m.bank && get32(b + 6) == m.generation && b[5] < m.count) m.active = b[5];
+  }
+
+  HalDisplay& display_; GfxRenderer& renderer_; bool geometryLogged_ = false;
+  GfxRenderer::Orientation savedOrientation_; bool orientationSaved_ = false; bool blitLoggedOnce_ = false;
+  HalFile stagingFile_;
+  size_t stagingBytes_ = 0;
+  bool stagingFileOk_ = false, deferNextBundle_ = false, deferCommit_ = false, ready_ = false;
+  bool stagingActive_ = false; uint8_t stagingNext_ = 0, stagingEnd_ = 0; Manifest staging_;
+  bool activeCacheValid_ = false; Manifest activeCache_;
+  uint8_t verifyChunk_[2048] = {};
+};
+}  // namespace
+
+SidecarSink* sidecarSinkInstance() { static SidecarSinkX3 instance(display, renderer); return &instance; }
+#endif
